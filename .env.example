# 163 邮箱地址
NETEASE_EMAIL=yourname@163.com

# 163 邮箱「授权码」（不是登录密码）
# 在 mail.163.com → 设置 → POP3/SMTP/IMAP 里开启 IMAP 后获取
NETEASE_AUTH_CODE=your_authorization_code

# 可选，默认 imap.163.com
# NETEASE_IMAP_HOST=imap.163.com

# 可选，默认 993
# NETEASE_IMAP_PORT=993

# QQ 邮箱地址
QQ_EMAIL=yourname@qq.com

# QQ 邮箱「授权码」（不是登录密码）
# 在 mail.qq.com → 设置 → 账户 → POP3/IMAP/SMTP 里开启 IMAP 后获取
QQ_AUTH_CODE=your_authorization_code

# 可选，默认 imap.qq.com
# QQ_IMAP_HOST=imap.qq.com

# 可选，默认 993
# QQ_IMAP_PORT=993
